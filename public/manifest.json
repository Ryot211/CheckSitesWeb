{
  "manifest_version": 3,
  "name": "Detector de Sitios Falsos",
  "version": "0.1.0",
  "description": "Detecta sitios de phishing y dominios fraudulentos analizando la URL y el contenido de la página.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "scripting", "tabs"]
}
